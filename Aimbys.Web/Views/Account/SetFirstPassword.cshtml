@model Aimbys.Web.ViewModels.Account.SetFirstPasswordViewModel
@{
    ViewData["Title"] = "Set Your Password";
    Layout = "/Views/Shared/_LayoutMinimal.cshtml";
}

<div class="d-flex align-items-center justify-content-center min-vh-100"
     style="background: #0d1b2e;">
    <div class="w-100" style="max-width: 480px; padding: 1.5rem;">

        @* Brand header  *@
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-3 mb-3"
                 style="width:56px;height:56px;background:#1d4ed8;">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                     fill="white" viewBox="0 0 16 16">
                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                </svg>
            </div>
            <h1 class="h4 fw-bold text-white mb-1">Set Your Password</h1>
            <p class="text-secondary small mb-0">
                You've logged in with your temporary password. Now enter your
                <strong class="text-white">8-digit Institute Login ID</strong>
                (the digits after <code class="text-info">Aimbys@</code> in your initial password)
                to verify your identity, then choose a permanent password.
            </p>
        </div>

        <div class="card border-0 rounded-4 shadow-lg p-4"
             style="background:#132038;">

            @* What is the Institute Login ID? info box  *@
            <div class="alert alert-info border-0 rounded-3 d-flex gap-2 align-items-start py-2 px-3 mb-4"
                 style="background:#1d4ed822;border-left:3px solid #60a5fa !important;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     fill="#60a5fa" viewBox="0 0 16 16" class="flex-shrink-0 mt-1">
                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
                </svg>
                <div class="small text-white-50">
                    You logged in with a temporary password. To confirm your identity and set
                    a permanent password, enter the
                    <strong class="text-white">8-digit Institute Login ID</strong>
                    that your Super Admin shared with you (the last 8 characters of your
                    initial password, e.g. if your password was
                    <code class="text-info">Aimbys@45821693</code> the ID is
                    <strong class="text-white">45821693</strong>).
                </div>
            </div>

            @if (TempData["Error"] is string errMsg)
            {
                <div class="alert alert-danger rounded-3 py-2 small" role="alert">
                    @errMsg
                </div>
            }

            <form asp-action="SetFirstPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3 py-2 small mb-3"></div>

                @* Institute Login ID  *@
                <div class="mb-4">
                    <label asp-for="InstituteLoginId"
                           class="form-label fw-semibold text-white small mb-1">
                        Institute Login ID
                        <span class="badge rounded-pill ms-1"
                              style="background:#1d4ed8;font-size:0.65rem;">
                            8 digits
                        </span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text border-0 rounded-start-3"
                              style="background:#0d1b2e;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                 fill="#60a5fa" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                            </svg>
                        </span>
                        <input asp-for="InstituteLoginId"
                               class="form-control border-0 rounded-end-3 text-white fw-bold"
                               style="background:#0d1b2e;letter-spacing:0.25em;font-size:1.1rem;"
                               placeholder="e.g. 45821693"
                               maxlength="8"
                               inputmode="numeric"
                               pattern="\d{8}"
                               autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="InstituteLoginId"
                          class="text-danger small mt-1 d-block"></span>
                </div>

                <hr style="border-color:#1e3a5f;" class="my-3" />

                @* New Password  *@
                <div class="mb-3">
                    <label asp-for="NewPassword"
                           class="form-label fw-semibold text-white small mb-1">
                        New Password
                    </label>
                    <input asp-for="NewPassword"
                           class="form-control border-0 rounded-3 text-white"
                           style="background:#0d1b2e;"
                           placeholder="Min. 8 characters"
                           autocomplete="new-password"
                           id="newPasswordInput" />
                    <span asp-validation-for="NewPassword"
                          class="text-danger small mt-1 d-block"></span>

                    @* Simple strength bar  *@
                    <div class="mt-2">
                        <div class="progress" style="height:4px;background:#1e3a5f;">
                            <div id="strengthBar"
                                 class="progress-bar"
                                 role="progressbar"
                                 style="width:0%;transition:width .3s,background .3s;"></div>
                        </div>
                        <div id="strengthLabel"
                             class="text-secondary small mt-1"
                             style="font-size:0.7rem;"></div>
                    </div>
                </div>

                @* Confirm Password  *@
                <div class="mb-4">
                    <label asp-for="ConfirmPassword"
                           class="form-label fw-semibold text-white small mb-1">
                        Confirm New Password
                    </label>
                    <input asp-for="ConfirmPassword"
                           class="form-control border-0 rounded-3 text-white"
                           style="background:#0d1b2e;"
                           placeholder="Re-enter your new password"
                           autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 fw-semibold rounded-3 py-2">
                    Set Password &amp; Continue
                </button>
            </form>
        </div>

        <p class="text-center text-secondary small mt-3">
            Lost your Institute Login ID?
            <a href="mailto:support@aimbys.in" class="text-white-50">
                Contact your Super Admin
            </a>
        </p>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var input  = document.getElementById('newPasswordInput');
        var bar    = document.getElementById('strengthBar');
        var label  = document.getElementById('strengthLabel');

        if (!input) return;

        input.addEventListener('input', function () {
            var pw = input.value;
            var score = 0;
            if (pw.length >= 8)  score++;
            if (/[A-Z]/.test(pw)) score++;
            if (/[0-9]/.test(pw)) score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;

            var pct    = ['0%', '25%', '50%', '75%', '100%'][score];
            var colour = ['#dc2626', '#f59e0b', '#f59e0b', '#22c55e', '#16a34a'][score];
            var text   = ['', 'Weak', 'Fair', 'Good', 'Strong'][score];

            bar.style.width      = pct;
            bar.style.background = colour;
            label.textContent    = text;
        });
    })();
    </script>
}
