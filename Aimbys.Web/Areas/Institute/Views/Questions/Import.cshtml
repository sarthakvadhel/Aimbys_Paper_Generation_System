@using Aimbys.Domain.Entities
@{
    ViewData["Title"] = "Import Questions";
    var subjects = ViewBag.Subjects as IEnumerable<Subject> ?? Enumerable.Empty<Subject>();
}

<h4 class="mb-4">Import Questions</h4>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h6 class="card-title">Step 1 — Download the template &amp; fill it in</h6>
        <a asp-action="DownloadTemplate" asp-area="Institute" asp-controller="Questions"
           class="btn btn-outline-primary btn-sm mb-3">
            <i class="bi bi-download me-1"></i> Download CSV Template
        </a>

        <p class="mb-1 small fw-semibold">Your active subjects (use these in the <code>SubjectCode</code> column):</p>
        @if (!subjects.Any())
        {
            <div class="alert alert-warning py-2 small">
                No subjects found. Go to <a asp-area="Institute" asp-controller="Subjects" asp-action="Index">Settings → Subjects</a> and create at least one before importing.
            </div>
        }
        else
        {
            <table class="table table-sm table-bordered w-auto mb-3">
                <thead class="table-light">
                    <tr><th>Name</th><th>Code (use this in CSV)</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in subjects)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td><code>@(s.Code ?? s.Name)</code></td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <p class="small text-muted mb-0">
            CSV columns: <code>Type, SubjectCode, BodyHtml, Difficulty, BloomLevel, Marks, OptionA, OptionB, OptionC, OptionD, CorrectAnswer</code><br />
            <strong>Type</strong>: MCQ or Descriptive &nbsp;|&nbsp;
            <strong>Difficulty</strong>: Easy, Medium, Hard &nbsp;|&nbsp;
            <strong>BloomLevel</strong>: Remember, Understand, Apply, Analyze, Evaluate, Create
        </p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h6 class="card-title">Step 2 — Upload your filled CSV</h6>
        <form asp-action="Import" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <input type="file" name="file" class="form-control" accept=".csv" required />
            </div>
            <button type="submit" class="btn btn-primary">Import</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
