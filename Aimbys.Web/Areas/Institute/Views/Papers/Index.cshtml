@model IEnumerable<Aimbys.Domain.Entities.Papers.Paper>
@{
    ViewData["Title"] = "Paper Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Paper Approvals</h4>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-muted text-center py-4">No papers submitted yet.</div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var version = p.Versions.FirstOrDefault(v => v.Id == p.CurrentVersionId);
                        var title = version?.Title ?? "Untitled";
                        var badgeClass = p.Status switch {
                            Aimbys.Domain.Enums.PaperStatus.SubmittedForApproval => "bg-warning text-dark",
                            Aimbys.Domain.Enums.PaperStatus.Approved => "bg-success",
                            Aimbys.Domain.Enums.PaperStatus.Returned => "bg-danger",
                            Aimbys.Domain.Enums.PaperStatus.Draft => "bg-secondary",
                            _ => "bg-dark"
                        };
                        <tr>
                            <td>@title</td>
                            <td><span class="badge @badgeClass">@p.Status</span></td>
                            <td>@p.UpdatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (p.Status == Aimbys.Domain.Enums.PaperStatus.SubmittedForApproval)
                                {
                                    <form asp-action="Approve" asp-route-id="@p.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm me-1">Approve</button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            data-bs-toggle="modal" data-bs-target="#returnModal-@p.Id">
                                        Return
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Return modals *@
    @foreach (var p in Model.Where(p => p.Status == Aimbys.Domain.Enums.PaperStatus.SubmittedForApproval))
    {
        <div class="modal fade" id="returnModal-@p.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Return" asp-route-id="@p.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Return Paper</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label">Comment <span class="text-danger">*</span></label>
                            <textarea name="comment" class="form-control" rows="3" required></textarea>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger">Return to Author</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
