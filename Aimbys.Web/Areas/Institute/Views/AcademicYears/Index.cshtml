@model IEnumerable<Aimbys.Domain.Entities.AcademicYear>
@{
    ViewData["Title"] = "Academic Years";
    var tableModel = new Aimbys.Web.Models.UI.DataTableModel(
        Caption: "Academic Years",
        Columns: new[]
        {
            new Aimbys.Web.Models.UI.DataTableColumn("Name"),
            new Aimbys.Web.Models.UI.DataTableColumn("Start"),
            new Aimbys.Web.Models.UI.DataTableColumn("End"),
            new Aimbys.Web.Models.UI.DataTableColumn("Current", Aimbys.Web.Models.UI.DataTableAlign.Center),
            new Aimbys.Web.Models.UI.DataTableColumn("Actions", Aimbys.Web.Models.UI.DataTableAlign.End)
        },
        Rows: Model.Select(y => new Aimbys.Web.Models.UI.DataTableRow(new Aimbys.Web.Models.UI.DataTableCell[]
        {
            new(y.Name),
            new(y.StartDate.ToString("yyyy-MM-dd")),
            new(y.EndDate.ToString("yyyy-MM-dd")),
            new(y.IsCurrent ? "<span class=\"badge bg-primary\">Current</span>" : "—", IsHtml: true),
            new($"<a href=\"#\" class=\"btn btn-sm btn-outline-primary\">Set Current</a>", IsHtml: true)
        })).ToList(),
        EmptyMessage: "No academic years configured yet.");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Academic Years</h4>
    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addYearModal">+ Add Academic Year</button>
</div>

<partial name="_DataTable" model="tableModel" />

<div class="modal fade" id="addYearModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-area="Institute" asp-controller="AcademicYears" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Academic Year</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. 2024-25" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Start Date <span class="text-danger">*</span></label>
                        <input type="date" name="startDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End Date <span class="text-danger">*</span></label>
                        <input type="date" name="endDate" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
