@model Aimbys.Web.ViewModels.Institutes.InstituteIndexViewModel
@{
    ViewData["Title"] = "Institutes";
    var newLoginId = TempData["NewInstituteLoginId"] as string;
}

<div class="container-fluid py-4 px-3 px-md-4">

    <header class="mb-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div>
            <div class="text-secondary small text-uppercase" style="letter-spacing: 0.08em;">SuperAdmin / Institutes</div>
            <h1 class="h3 fw-bold mt-1 mb-0">Institute Management</h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Export" asp-route-status="@Context.Request.Query["status"]" asp-route-type="@Context.Request.Query["type"]"
               class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-download"></i> Export CSV
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i> New Institute
            </a>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(newLoginId))
    {
        var fullPassword = $"Aimbys@{newLoginId}";
        <div class="alert border-0 rounded-4 p-4 mb-3 d-flex align-items-start gap-3"
             style="background:#052e16;"
             id="loginIdBanner">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26"
                 fill="#4ade80" viewBox="0 0 16 16" class="flex-shrink-0 mt-1">
                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
            </svg>
            <div class="flex-grow-1">
                <div class="fw-bold mb-1" style="color:#4ade80;">Institute &amp; Admin Account Created</div>
                <p class="mb-2 text-white-50 small">
                    Share these credentials securely with the Institute Admin.
                    On <strong class="text-white">first login</strong>, the admin enters their
                    email and the <strong class="text-white">full password below</strong>.
                    They will then be asked to set a new password.
                    <strong class="text-warning">This will not be shown again — record it now.</strong>
                </p>

                <div class="row g-2 mb-3">
                    <div class="col-12">
                        <div class="rounded-3 px-3 py-2 d-flex justify-content-between align-items-center"
                             style="background:#0a3d22;">
                            <div>
                                <div class="text-secondary" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;">Institute Login ID (8-digit code)</div>
                                <span class="fw-bold text-white"
                                      style="font-size:1.4rem;letter-spacing:0.25em;font-family:monospace;">
                                    @newLoginId
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="rounded-3 px-3 py-2 d-flex justify-content-between align-items-center"
                             style="background:#1e3a5f;">
                            <div>
                                <div class="text-secondary" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;">First-Login Password (type this exactly)</div>
                                <span class="fw-bold text-white"
                                      id="firstLoginPwd"
                                      style="font-size:1.4rem;letter-spacing:0.12em;font-family:monospace;">
                                    Aimbys&commat;@newLoginId
                                </span>
                            </div>
                            <button type="button"
                                    id="indexCopyBtn"
                                    class="btn btn-sm btn-outline-success ms-3 flex-shrink-0"
                                    data-password="Aimbys@@@newLoginId"
                                    onclick="aimbysAdminCopy(this)">
                                Copy
                            </button>
                        </div>
                    </div>
                </div>

                <div class="alert border-0 rounded-3 py-2 px-3 mb-0 small"
                     style="background:#1a2e1a;">
                    <strong class="text-white">Login instructions for the Institute Admin:</strong>
                    <ol class="mb-0 mt-1 text-white-50 ps-3">
                        <li>Go to the login page and enter email: <code style="color:#93c5fd;">@(TempData["NewInstituteAdminEmail"] as string ?? "the admin email")</code></li>
                        <li>Enter password: <code style="color:#4ade80;" id="pwdHint">Aimbys&commat;@newLoginId</code></li>
                        <li>You will be redirected to set a permanent password.</li>
                        <li>On the next screen enter the 8-digit code <strong class="text-white">@newLoginId</strong> to verify your identity.</li>
                    </ol>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
        <script>
        function aimbysAdminCopy(btn) {
            var pw = btn.getAttribute('data-password');
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(pw).then(function () {
                    btn.textContent = '✓ Copied!';
                    setTimeout(function () { btn.textContent = 'Copy'; }, 2500);
                });
            } else {
                // Fallback for http:// dev environments
                var ta = document.createElement('textarea');
                ta.value = pw; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); btn.textContent = '✓ Copied!'; }
                catch(e) { btn.textContent = 'Copy failed'; }
                document.body.removeChild(ta);
                setTimeout(function () { btn.textContent = 'Copy'; }, 2500);
            }
        }
        </script>
    }
    else if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <partial name="_FilterBar" model="Model.FilterBar" />

    <div class="mt-3">
        <partial name="_DataTable" model="Model.Table" />
    </div>

    <partial name="_PaginationPartial" model="Model.Pagination" />

</div>
