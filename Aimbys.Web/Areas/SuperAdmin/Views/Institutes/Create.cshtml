@model Aimbys.Web.ViewModels.Institutes.InstituteCreateViewModel
@{
    ViewData["Title"] = "Create Institute";
    var newLoginId = TempData["NewInstituteLoginId"] as string;
}

<div class="container-fluid py-4 px-3 px-md-4" style="max-width: 720px;">

    <header class="mb-4">
        <div class="text-secondary small text-uppercase" style="letter-spacing: 0.08em;">SuperAdmin / Institutes</div>
        <h1 class="h3 fw-bold mt-1 mb-0">Create Institute</h1>
    </header>

    @if (!string.IsNullOrEmpty(newLoginId))
    {
        var fullPassword = $"Aimbys@{newLoginId}";
        <div class="alert border-0 rounded-4 p-4 mb-4 d-flex align-items-start gap-3"
             style="background:#052e16; border-left:4px solid #16a34a !important;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                 fill="#4ade80" viewBox="0 0 16 16" class="flex-shrink-0 mt-1">
                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
            </svg>
            <div>
                <div class="fw-bold mb-1" style="color:#4ade80;">Institute Created Successfully</div>
                <p class="mb-2 text-white-50 small">
                    Share the <strong class="text-white">first-login password</strong> below with the
                    admin — they enter it exactly as shown in the Password field.
                    <strong class="text-warning">This will not be shown again.</strong>
                </p>
                <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                    <div class="d-flex align-items-center gap-2 rounded-3 px-4 py-2"
                         style="background:#0a3d22;">
                        <span class="text-secondary small">First-Login Password</span>
                        <span id="loginIdDisplay"
                              class="fw-bold text-white"
                              style="font-size:1.4rem;letter-spacing:0.12em;font-family:monospace;">
                            Aimbys&commat;@newLoginId
                        </span>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            data-password="Aimbys@@@newLoginId"
                            onclick="aimbysAdminCopy(this)">
                        Copy
                    </button>
                </div>
                <div class="text-white-50 small">
                    Institute Login ID (for identity verification after first login):
                    <strong class="text-white" style="font-family:monospace;letter-spacing:0.2em;">@newLoginId</strong>
                </div>
            </div>
        </div>
        <script>
        function aimbysAdminCopy(btn) {
            var pw = btn.getAttribute('data-password');
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(pw).then(function () {
                    btn.textContent = '✓ Copied!';
                    setTimeout(function () { btn.textContent = 'Copy'; }, 2500);
                });
            } else {
                var ta = document.createElement('textarea');
                ta.value = pw; ta.style.position = 'fixed'; ta.style.opacity = '0';
                document.body.appendChild(ta); ta.select();
                try { document.execCommand('copy'); btn.textContent = '✓ Copied!'; }
                catch(e) { btn.textContent = 'Copy failed'; }
                document.body.removeChild(ta);
                setTimeout(function () { btn.textContent = 'Copy'; }, 2500);
            }
        }
        </script>
    }

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert alert-danger rounded-3 py-2 small mb-3">@errorMsg</div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="Create" method="post" class="card border rounded-3 p-4">

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" placeholder="e.g. DPS-RKP" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<Aimbys.Domain.Enums.InstituteType>()" class="form-select"></select>
                <span asp-validation-for="Type" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LicenseTier" class="form-label"></label>
                <select asp-for="LicenseTier" asp-items="Html.GetEnumSelectList<Aimbys.Domain.Enums.LicenseTier>()" class="form-select"></select>
                <span asp-validation-for="LicenseTier" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="State" class="form-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Country" class="form-label"></label>
                <input asp-for="Country" class="form-control" />
                <span asp-validation-for="Country" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label asp-for="ContactEmail" class="form-label"></label>
                <input asp-for="ContactEmail" class="form-control" type="email" />
                <span asp-validation-for="ContactEmail" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactPhone" class="form-label"></label>
                <input asp-for="ContactPhone" class="form-control" type="tel" />
                <span asp-validation-for="ContactPhone" class="text-danger small"></span>
            </div>
        </div>

        <hr class="my-4" />

        <h6 class="fw-semibold">Institute Admin</h6>
        <p class="text-secondary small">An Identity user with the InstituteAdmin role will be created for this email.</p>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="AdminEmail" class="form-label"></label>
                <input asp-for="AdminEmail" class="form-control" type="email" />
                <span asp-validation-for="AdminEmail" class="text-danger small"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create Institute</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
