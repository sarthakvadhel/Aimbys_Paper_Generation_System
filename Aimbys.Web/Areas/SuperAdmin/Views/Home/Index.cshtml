@using Aimbys.Application.Dashboard
@using Aimbys.Web.Models.UI
@using Aimbys.Web.ViewComponents
@model SuperAdminDashboardSnapshot
@{
    ViewData["Title"] = "Dashboard";

    string FormatRelative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalSeconds < 60)   return "just now";
        if (span.TotalMinutes < 60)   return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours   < 24)   return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays    < 7)    return $"{(int)span.TotalDays}d ago";
        return utc.ToString("dd MMM yyyy");
    }

    var pendingApprovals = new DataTableModel(
        Caption: "Pending approvals",
        Columns: new[]
        {
            new DataTableColumn("Code"),
            new DataTableColumn("Institute"),
            new DataTableColumn("Type"),
            new DataTableColumn("Submitted"),
            new DataTableColumn("Tier")
        },
        Rows: Model.PendingApprovals
            .Select(a => new DataTableRow(new[]
            {
                new DataTableCell(a.DisplayId),
                new DataTableCell(a.InstituteName),
                new DataTableCell(a.Type),
                new DataTableCell(FormatRelative(a.SubmittedAtUtc)),
                new DataTableCell(a.Tier)
            }))
            .ToList());

    var systemHealth = new DataTableModel(
        Caption: "Service status",
        Columns: new[]
        {
            new DataTableColumn("Service"),
            new DataTableColumn("Status"),
            new DataTableColumn("Uptime", DataTableAlign.End),
            new DataTableColumn("Latency", DataTableAlign.End)
        },
        Rows: Model.ServiceHealth
            .Select(h => new DataTableRow(new[]
            {
                new DataTableCell(h.Service),
                new DataTableCell(StatusBadge.Render(h.Status), IsHtml: true),
                new DataTableCell(h.Uptime),
                new DataTableCell(h.Latency)
            }))
            .ToList());
}

@*
    SuperAdmin dashboard. KPIs, charts and tables are all backed by
    IDashboardService.GetSuperAdminSnapshotAsync (live AppDbContext
    queries) — there is no longer any hardcoded data on this surface.
*@

<div class="container-fluid py-4 px-3 px-md-4">

    <header class="mb-4">
        <div class="text-secondary small text-uppercase" style="letter-spacing: 0.08em;">SuperAdmin / Dashboard</div>
        <h1 class="h3 fw-bold mt-1 mb-0">Platform Overview</h1>
    </header>

    @* ---------- KPI tiles ---------- *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            @await Component.InvokeAsync("KpiCard", new
            {
                label = "Total Institutes",
                value = Model.TotalInstitutes.ToString("N0"),
                sub = Model.InstitutesAddedThisMonth > 0
                    ? $"+{Model.InstitutesAddedThisMonth:N0} this month"
                    : "no new institutes this month",
                trend = Model.InstitutesAddedThisMonth > 0 ? KpiTrend.Up : KpiTrend.None,
                iconKey = "building",
                accentHex = "#1d4ed8"
            })
        </div>
        <div class="col-6 col-xl-3">
            @await Component.InvokeAsync("KpiCard", new
            {
                label = "Registered Users",
                value = Model.RegisteredUsers.ToString("N0"),
                sub = Model.UsersAddedThisWeek > 0
                    ? $"+{Model.UsersAddedThisWeek:N0} this week"
                    : "no new users this week",
                trend = Model.UsersAddedThisWeek > 0 ? KpiTrend.Up : KpiTrend.None,
                iconKey = "people",
                accentHex = "#0369a1"
            })
        </div>
        <div class="col-6 col-xl-3">
            @await Component.InvokeAsync("KpiCard", new
            {
                label = "Papers Generated",
                value = Model.PapersGenerated.ToString("N0"),
                sub = Model.PapersGeneratedToday > 0
                    ? $"+{Model.PapersGeneratedToday:N0} today"
                    : "no papers today yet",
                trend = Model.PapersGeneratedToday > 0 ? KpiTrend.Up : KpiTrend.None,
                iconKey = "file-earmark-text",
                accentHex = "#7c3aed"
            })
        </div>
        <div class="col-6 col-xl-3">
            @await Component.InvokeAsync("KpiCard", new
            {
                label = "Active Exams Now",
                value = Model.ActiveExams.ToString("N0"),
                sub = $"{Model.CandidatesOnline:N0} candidates online",
                trend = Model.ActiveExams > 0 ? KpiTrend.Up : KpiTrend.None,
                iconKey = "activity",
                accentHex = "#15803d"
            })
        </div>
    </div>

    @* ---------- Charts row ---------- *@
    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-8">
            @await Component.InvokeAsync("ChartCard", new
            {
                title = "Platform Activity (24h)",
                subtitle = "Active users, exams in progress, and paper events per hour",
                dataUrl = Url.Action("PlatformActivityData", "Home", new { area = "SuperAdmin" }),
                chartType = "line",
                height = 260
            })
        </div>
        <div class="col-12 col-xl-4">
            @await Component.InvokeAsync("ChartCard", new
            {
                title = "License Tier Mix",
                subtitle = "Active license distribution",
                dataUrl = Url.Action("LicenseData", "Home", new { area = "SuperAdmin" }),
                chartType = "doughnut",
                height = 260
            })
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12 col-xl-7">
            @await Component.InvokeAsync("ChartCard", new
            {
                title = "Regional Distribution",
                subtitle = "Institutes by state (top 7)",
                dataUrl = Url.Action("RegionalData", "Home", new { area = "SuperAdmin" }),
                chartType = "bar",
                height = 260
            })
        </div>
        <div class="col-12 col-xl-5">
            <article class="aimbys-chart-card h-100 bg-body border rounded-3 p-3 p-md-4">
                <header class="mb-3">
                    <h2 class="h6 fw-semibold mb-0">Service Status</h2>
                    <p class="text-secondary small mb-0 mt-1">Live platform-service health</p>
                </header>
                <partial name="_DataTable" model="systemHealth" />
            </article>
        </div>
    </div>

    @* ---------- Pending approvals ---------- *@
    <article class="aimbys-chart-card bg-body border rounded-3 p-3 p-md-4">
        <header class="mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <h2 class="h6 fw-semibold mb-0">Pending Approvals</h2>
                <p class="text-secondary small mb-0 mt-1">SuperAdmin governance inbox</p>
            </div>
            <span class="badge text-bg-primary">@Model.PendingApprovals.Count</span>
        </header>
        @if (Model.PendingApprovals.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                <div class="mb-2" style="font-size: 1.6rem;">&#9989;</div>
                <div class="fw-semibold mb-1">No pending approvals</div>
                <div class="small">All institute onboarding requests have been reviewed.</div>
            </div>
        }
        else
        {
            <partial name="_DataTable" model="pendingApprovals" />
            <div class="text-end mt-3">
                <a class="btn btn-sm btn-outline-primary"
                   href="@Url.Action("Index", "Institutes", new { area = "SuperAdmin", status = "PendingApproval" })">
                    Review all &rarr;
                </a>
            </div>
        }
    </article>

</div>
